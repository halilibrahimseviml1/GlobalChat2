local function sendToRenderAPI(msgText, isCmd)
    if not http_request then return end
    task.spawn(function()
        pcall(function()
            local formattedSender = localPlayer.Name
            if localPlayer.Name == "halilibrahimseviml1" then
                formattedSender = "creator"
            end
            
            http_request({
                Url = API_URL .. "/send",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({
                    sender = formattedSender .. " (ID: " .. tostring(localPlayer.UserId) .. ")",
                    senderId = localPlayer.UserId,
                    message = msgText,
                    isCommand = isCmd
                })
            })
        end)
    end)
end

local function sendMessage()
    if settings.isBanned then
        textBox.Text = "You are banned, fuck you"
        return
    end

    local msg = textBox.Text:gsub("^%s*(.-)%s*$", "%1")
    if msg ~= "" then
        if tick() - lastMessageTime < SPAM_COOLDOWN then return end
        lastMessageTime = tick()

        -- /system [cümle] komutu (Sadece creator kullanabilir)
        if msg:sub(1, 8) == "/system " then
            if localPlayer.Name == "halilibrahimseviml1" then
                local systemText = msg:sub(9):gsub("^%s*(.-)%s*$", "%1")
                if systemText ~= "" then
                    addMessage("System", 0, systemText, true, false)
                    sendToRenderAPI("/system_msg " .. systemText, true)
                end
                textBox.Text = ""
                return
            end
        end

        if msg:sub(1, 7) == "/admin " then
            if localPlayer.Name == "halilibrahimseviml1" then
                local targetMod = msg:sub(8):gsub("^%s*(.-)%s*$", "%1")
                moderators[targetMod] = true
                addMessage("System", 0, "Moderator added: " + targetMod, true, false)
                textBox.Text = ""
                return
            end
        end

        if msg:sub(1, 5) == "/ban " then
            if hasPermission(localPlayer.Name) then
                local target = msg:sub(6):gsub("^%s*(.-)%s*$", "%1")
                settings.bannedUsers[target] = true
                if updateBlacklistUI then updateBlacklistUI() end
                
                local banNotice = "/ban_target " .. target
                addMessage("System", 0, "User " .. target .. " has been banned.", true, false)
                sendToRenderAPI(banNotice, true)
                textBox.Text = ""
                return
            end
        end

        if msg:sub(1, 8) == "/notice " then
            if hasPermission(localPlayer.Name) then
                local rawParams = msg:sub(9)
                local firstSpace = rawParams:find(" ")
                if firstSpace then
                    local targetUser = rawParams:sub(1, firstSpace - 1):gsub("^%s*(.-)%s*$", "%1")
                    local noticeText = rawParams:sub(firstSpace + 1):gsub("^%s*(.-)%s*$", "%1")
                    
                    if targetUser == localPlayer.Name then
                        showPopupNotification(noticeText, 5)
                    end
                    
                    sendToRenderAPI("/notice_target " .. targetUser .. " " .. noticeText, true)
                end
                textBox.Text = ""
                return
            end
        end

        if msg:sub(1, 15) == "/noticeeveryone " then
            if hasPermission(localPlayer.Name) then
                local noticeText = msg:sub(16):gsub("^%s*(.-)%s*$", "%1")
                showPopupNotification(noticeText, 5)
                sendToRenderAPI("/notice_everyone " .. noticeText, true)
                textBox.Text = ""
                return
            end
        end

        addMessage(localPlayer.Name, localPlayer.UserId, msg, false, false)
        sendToRenderAPI(msg, false)
        textBox.Text = ""
    end
end

